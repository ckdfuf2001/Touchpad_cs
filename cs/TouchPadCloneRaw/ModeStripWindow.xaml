<Window x:Class="TouchPadCloneV2.ModeStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchPadClone ModeStrip" WindowStyle="None" AllowsTransparency="True"
        Background="#5910131A" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Width="380" Height="86">
    <Border x:Name="Surface" Background="#5910131A">
        <StackPanel Orientation="Vertical">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CloseBtn" Grid.Column="0" Content="X" FontSize="12"
                        Foreground="WhiteSmoke" Background="Transparent"
                        BorderBrush="Transparent" ToolTip="패드 닫기"/>
                <TextBlock x:Name="Label" Grid.Column="1" Text="◀  mode  ▶" Foreground="#9AA6BD"
                           FontSize="11" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button x:Name="ModeBtn" Grid.Column="2" Content="☰" FontSize="12"
                        Foreground="WhiteSmoke" Background="Transparent"
                        BorderBrush="Transparent" ToolTip="모드 변경"/>
                <Button x:Name="PadClose" Content="✕" Width="34" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,2,0" FontSize="12" Visibility="Collapsed"/>
            </Grid>
            <!-- Legacy in-bar menu retired: the menu lives in the picker
                 popup now (StripLayout cells). Kept collapsed so old code
                 referencing Rows still compiles. -->
            <StackPanel x:Name="Rows" Orientation="Vertical" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
