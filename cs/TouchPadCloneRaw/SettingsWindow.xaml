<Window x:Class="TouchPadCloneV2.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="TouchPad Clone - 설정" Width="560" Height="620"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <TabControl x:Name="Tabs" TabStripPlacement="Left">
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="커서·입력" FontWeight="Bold" Foreground="#35C4FF"/>
                <TextBlock Text="커서 속도" Margin="0,6,0,0"/>
                <Slider x:Name="Speed" Minimum="0.2" Maximum="5" TickFrequency="0.1"/>
                <CheckBox x:Name="TapClick" Content="탭 = 클릭 (끄면 탭 무시)" Margin="0,8,0,0"/>
                <CheckBox x:Name="SwapBtn" Content="좌/우 버튼 반전" Margin="0,4,0,0"/>
                <CheckBox x:Name="DebugLbl" Content="디버그 라벨 표시 (zone/status/actual)" Margin="0,4,0,0"/>
                <CheckBox x:Name="ScrollInv" Content="스크롤 상하반전" Margin="0,4,0,0"/>
                <TextBlock Text="물리 마우스" Margin="0,8,0,0"/>
                <ComboBox x:Name="PhysBox"/>
                <TextBlock x:Name="PhysHint" Foreground="Gray" TextWrapping="Wrap"
                           FontSize="11" Margin="0,2,0,0"/>
                <TextBlock Text="동작 판정 시간 (ms): 떼면 탭, 계속 누르면 홀드" Margin="0,8,0,0"/>
                <Slider x:Name="TapJudgeMs" Minimum="50" Maximum="1000" TickFrequency="50"/>
                <TextBlock Text="홀드 중 드래그로 간주하는 이동 (DIP/150ms)" Margin="0,8,0,0"/>
                <Slider x:Name="HoldSlop" Minimum="2" Maximum="60" TickFrequency="2"/>
                <TextBlock Text="홀드 중 커서 감쇠 (1 = 즉시 이동)" Margin="0,8,0,0"/>
                <Slider x:Name="HoldDampS" Minimum="0.2" Maximum="1" TickFrequency="0.05"/>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="이 패드는 손가락을 가만히 있어도 초당 약 0.4 DIP씩 서서히 새는 것으로 보고됩니다. 거리 기준으로 홀드 판정하면 0.2초 만에 취소되고, 커서를 멈추게 하면 패드가 0.5초 동안 죽습니다. 실측값(150ms 구간 순이동 기준)은 가만히 있는 손가락 약 0.06, 느린 조작 약 19, 빠른 드래그 104~150이므로 기본값 10은 그 사이에 있습니다. 값을 올리면 작은 이동을 롱프레스로 보고, 내리면 가만히 있어도 롱프레스가 취소됩니다. 감쇠를 낮추면 홀드 중 커서가 덜 새지만 즉시 이동도 함께 느려집니다."/>
                <TextBlock Text="더블/트리플 탭 판정 (ms)" Margin="0,8,0,0"/>
                <Slider x:Name="MultiMs" Minimum="200" Maximum="1000" TickFrequency="50"/>
                <Separator Margin="0,12,0,12"/>
                <TextBlock Text="패드 모양" FontWeight="Bold" Foreground="#35C4FF"/>
                <TextBlock Text="패드 투명도" Margin="0,6,0,0"/>
                <Slider x:Name="OpacityS" Minimum="0.2" Maximum="1" TickFrequency="0.05"/>
                <TextBlock Text="레이아웃 (원본 INI 섹션)" Margin="0,8,0,0"/>
                <ComboBox x:Name="LayoutBox"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="PresetBtn" Content="프리셋 INI 열기…" Width="130"/>
                    <Button x:Name="SaveBtn" Content="적용·저장" Width="100" Margin="8,0,0,0"/>
                </StackPanel>
                <Separator Margin="0,12,0,12"/>
                <TextBlock Text="게임 프리셋용 vJoy" FontWeight="Bold" Foreground="#35C4FF"/>
                <TextBlock x:Name="VjoyStatus" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="VjoyDl" Content="다운로드 페이지" Width="130"/>
                    <Button x:Name="VjoyFork" Content="Win10/11 포크" Width="120" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="vJoy 없이도 WASD 프리셋은 키보드 입력으로 대체 동작."
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="FloatPad">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="FloatPad 계열 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="floatpad / leftpad / rightpad / fullscreen …" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개로만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="FloatGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="ArtistPad">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="ArtistPad 계열 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="이름에 Artist가 들어간 섹션" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개로만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="ArtistGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Separator Margin="0,8,0,8"/>
                <TextBlock Text="아티스트 패드 (버튼 바)" FontWeight="Bold"/>
                <TextBlock Text="위치"/>
                <ComboBox x:Name="ArtPos" Margin="0,2,0,4"/>
                <TextBlock Text="커스텀 버튼 (표시명 = 동작키)"/>
                <ListBox x:Name="ArtBtns" Height="110" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ArtLabel" Width="110"/>
                    <TextBox x:Name="ArtAction" Width="110" Margin="4,0,0,0"/>
                    <Button x:Name="ArtAdd" Content="추가" Width="60" Margin="4,0,0,0"/>
                    <Button x:Name="ArtDel" Content="삭제" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="VirtualCtrls">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="VirtualCtrls 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="virtualctrls 섹션 (보조 컨트롤러)" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개로만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="VirtualGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Separator Margin="0,8,0,8"/>
                <TextBlock Text="버추얼 패드 (버튼 바)" FontWeight="Bold"/>
                <TextBlock Text="레이아웃"/>
                <ComboBox x:Name="VirtPos" Margin="0,2,0,4"/>
                <TextBlock Text="커스텀 버튼 (표시명 = 동작키)"/>
                <ListBox x:Name="VirtBtns" Height="110" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="VirtLabel" Width="110"/>
                    <TextBox x:Name="VirtAction" Width="110" Margin="4,0,0,0"/>
                    <Button x:Name="VirtAdd" Content="추가" Width="60" Margin="4,0,0,0"/>
                    <Button x:Name="VirtDel" Content="삭제" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="스트립">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <CheckBox x:Name="StripVisible" Content="스트립 보이기" Margin="0,0,0,6"/>
                <TextBlock Text="위치"/>
                <ComboBox x:Name="StripPos" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="120"><TextBlock Text="너비"/><TextBox x:Name="StripW"/></StackPanel>
                    <StackPanel Width="120" Margin="8,0,0,0"><TextBlock Text="높이"/><TextBox x:Name="StripH"/></StackPanel>
                </StackPanel>
                <TextBlock Text="1열: 그룹 라운드 버튼 (하나만 선택)" Margin="0,8,0,2"/>
                <ListBox x:Name="StripRow1" Height="80"/>
                <TextBlock Text="2열: 개별 토글 버튼" Margin="0,6,0,2"/>
                <ListBox x:Name="StripRow2" Height="80"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="StripName" Width="100" ToolTip="이름"/>
                    <ComboBox x:Name="StripKind" Width="76" Margin="4,0,0,0"/>
                    <TextBox x:Name="StripTarget" Width="120" Margin="4,0,0,0" ToolTip="대상 패드/액션키"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="StripAdd1" Content="1열 추가" Width="76"/>
                    <Button x:Name="StripAdd2" Content="2열 추가" Width="76" Margin="4,0,0,0"/>
                    <Button x:Name="StripDel" Content="삭제(고정 제외)" Width="104" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="대상: floatpad/leftpad/rightpad/fullscreen/artist/virtual/액션키/strip 액션" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="패드별">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="패드별 덮어쓰기 (전역과 동일 항목)" FontWeight="Bold"/>
                <TextBlock Text="패드"/>
                <ComboBox x:Name="PadSel" Margin="0,2,0,6"/>
                <TextBlock Text="영역 모드"/>
                <ComboBox x:Name="PadArea" Margin="0,2,0,6"/>
                <CheckBox x:Name="PadVisible" Content="영역 보이기 (fullscreen은 항상)" Margin="0,0,0,6"/>
                <TextBlock Text="투명도 (-1 = 전역 따름)"/>
                <TextBox x:Name="PadOpacity" Margin="0,2,0,6"/>
                <TextBlock Text="커서 속도 (-1 = 전역 따름)"/>
                <TextBox x:Name="PadSpeed" Margin="0,2,0,6"/>
                <TextBlock Text="판정 시간 ms (-1 = 전역 따름)"/>
                <TextBox x:Name="PadJudge" Margin="0,2,0,6"/>
                <TextBlock Text="스크롤 상하반전"/>
                <ComboBox x:Name="PadScroll" Margin="0,2,0,2"/>
                <TextBlock Text="좌/우 버튼 반전"/>
                <ComboBox x:Name="PadSwap" Margin="0,2,0,2"/>
                <TextBlock Text="탭 = 클릭"/>
                <ComboBox x:Name="PadTap" Margin="0,2,0,6"/>
                <Button x:Name="PadPreview" Content="미리보기 (해당 패드 적용)" Width="170" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="액션">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="커스텀 액션 (스트립·보조패드 버튼용)" FontWeight="Bold"/>
                <ListBox x:Name="ActList" Height="170" Margin="0,6,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ActKey" Width="96" ToolTip="키"/>
                    <ComboBox x:Name="ActKind" Width="86" Margin="4,0,0,0"/>
                    <TextBox x:Name="ActValue" Width="104" Margin="4,0,0,0" ToolTip="마우스액션명"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="ActPath" Width="190" ToolTip="프로그램 경로 / cmd 명령"/>
                    <TextBox x:Name="ActArgs" Width="110" Margin="4,0,0,0" ToolTip="인자"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ActAdd" Content="추가/갱신" Width="80"/>
                    <Button x:Name="ActDel" Content="삭제" Width="80" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
