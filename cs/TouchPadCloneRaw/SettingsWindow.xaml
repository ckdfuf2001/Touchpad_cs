<Window x:Class="TouchPadCloneV2.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TouchPadCloneV2"
        Title="TouchPad Clone - 설정" Width="560" Height="620"
        Topmost="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Our own title bar (no system caption): drag to move, touch close. -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="#FF141922">
        <Grid>
            <TextBlock Text="TouchPad Setting" Foreground="#E8ECF4"
                       FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                       IsHitTestVisible="False"/>
            <Button x:Name="TitleCloseBtn" Content="X" MinWidth="44" MinHeight="28"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,6,0" FontSize="14" Foreground="White"
                    Background="Transparent" BorderBrush="Transparent"
                    IsCancel="True"/>
        </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left">
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="Pad 색상" FontWeight="Bold" Foreground="#35C4FF" Margin="0,8,0,0"/>
                <UniformGrid Columns="6" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="이펙트" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="EffectPicker"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="L" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="ZoneLPicker"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="R" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="ZoneRPicker"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Wheel" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="ZoneWPicker"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Pad" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="ZonePPicker"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="배경" FontSize="11" Foreground="Gray"/>
                        <local:PalettePicker x:Name="ZoneBgPicker"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="클릭하면 팔레트(없음 포함)가 열립니다. 팔레트 끝에서 현재값을 확인하고 직접 입력도 가능합니다."/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="투명도 (80% ~ 0%)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityVal" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="OpacityS" Minimum="0.2" Maximum="1" TickFrequency="0.2" TickPlacement="BottomRight" IsSnapToTickEnabled="True" SmallChange="0.2" LargeChange="0.2"/>
                <TextBlock Text="동작" FontWeight="Bold" Foreground="#35C4FF" Margin="0,12,0,0"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="커서 속도배율 (0.2x ~ 5.0x)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpeedVal" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="Speed" Minimum="0.2" Maximum="5" TickFrequency="0.1"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="동작 판정 시간 (50 ~ 1000ms)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TapJudgeVal" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="TapJudgeMs" Minimum="50" Maximum="1000" TickFrequency="50"/>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <CheckBox x:Name="TapClick" Content="Pad tap = click" Margin="0,2,4,2"/>
                    <CheckBox x:Name="SwapBtn" Content="좌/우 버튼 반전" Margin="0,2,0,2"/>
                    <CheckBox x:Name="ScrollInv" Content="스크롤 상하반전" Margin="0,2,4,2"/>
                    <CheckBox x:Name="DebugLbl" Content="디버그 라벨 표시" Margin="0,2,0,2"/>
                </UniformGrid>
                <CheckBox x:Name="AutoStart" Content="Windows 시작 시 자동 실행" Margin="0,6,0,0"/>
                <TextBlock Text="스트립 설정" FontWeight="Bold" Foreground="#35C4FF" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="배경색" VerticalAlignment="Center"/>
                    <local:PalettePicker x:Name="StripColorPicker" Margin="4,0,0,0"/>
                    <TextBlock Text="글자색" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:PalettePicker x:Name="StripTextPicker" Margin="4,0,0,0"/>
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="투명도 (100% ~ 0%)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StripOpacityVal" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="StripOpacityS" Minimum="0" Maximum="1" TickFrequency="0.25" TickPlacement="BottomRight" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.25" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="모니터" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StripMonBox" Width="150" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="위치" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StripEdgeBox" Width="64" Margin="4,0,0,0"/>
                    <ComboBox x:Name="StripSideBox" Width="64" Margin="4,0,0,0"/>
                    <TextBox x:Name="StripPxBox" Width="60" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="px (-1 중앙, 중앙: +오른쪽/-왼쪽)" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="크기" VerticalAlignment="Center"/>
                    <TextBox x:Name="StripWBox" Width="60" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="x" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="StripHBox" Width="60" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="가로 x 세로" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="레이아웃" FontWeight="Bold" Foreground="#35C4FF" Margin="0,12,0,0"/>
                <StackPanel x:Name="StripRows" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="StripRowAdd2" Content="행 추가" Width="80"/>
                </StackPanel>
                <TextBlock Text="레이아웃 상세 (위 메뉴 클릭 시)" FontWeight="Bold" Foreground="#35C4FF" Margin="0,8,0,0"/>
                <Border BorderBrush="#335C6C7D" BorderThickness="1" CornerRadius="6" Background="#155C6C7D" Margin="0,4,0,0" Padding="6">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="표시명" Grid.Row="0" VerticalAlignment="Center"/>
                    <TextBlock Text="배경색" Grid.Row="1" VerticalAlignment="Center"/>
                    <local:PalettePicker x:Name="CellIconPicker" Grid.Row="1" Grid.Column="1" Margin="4,2,0,2" HorizontalAlignment="Left"/>
                    <TextBlock Text="글자색" Grid.Row="2" VerticalAlignment="Center"/>
                    <local:PalettePicker x:Name="CellTextPicker" Grid.Row="2" Grid.Column="1" Margin="4,2,0,2" HorizontalAlignment="Left"/>
                    <TextBlock Text="구분" Grid.Row="3" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CellKindBox" Grid.Row="3" Grid.Column="1" Margin="4,2,0,2"/>
                    <TextBlock Text="값 입력" Grid.Row="4" VerticalAlignment="Center"/>
                    <TextBox x:Name="CellValueBox" Grid.Row="4" Grid.Column="1" Margin="4,2,0,2"/>
                    <StackPanel x:Name="CellFuncPanel" Grid.Row="4" Grid.Column="1" Margin="4,2,0,2" Orientation="Horizontal">
                        <ComboBox x:Name="CellFuncGroupBox" Width="86"/>
                        <ComboBox x:Name="CellFuncBox" Width="230" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="크기 (0=자동)" Grid.Row="5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1" Margin="4,2,0,2">
                        <TextBox x:Name="CellWBox" Width="60" ToolTip="너비"/>
                        <TextBlock Text="x" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox x:Name="CellHBox" Width="60" ToolTip="높이"/>
                    </StackPanel>
                    <TextBlock Text="" Grid.Row="6"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1" Margin="4,2,0,2">
                        <Button x:Name="CellClearBtn" Content="지우기" Width="80"/>
                        <Button x:Name="CellDelBtn" Content="셀삭제" Width="80" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="4,2,0,2">
                        <TextBox x:Name="CellLabelBox" Width="200"/>
                        <Button x:Name="CellInsertBtn" Content="삽입" Width="52" Margin="4,0,0,0"/>
                        <Popup x:Name="InsertPopup" Placement="Bottom" StaysOpen="False">
                            <Border Background="#FFF5F5F5" BorderBrush="Gray" BorderThickness="1" Padding="6">
                                <TabControl x:Name="InsertTabs" Width="330" Height="240">
                                    <TabItem Header="이모지">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <UniformGrid x:Name="EmojiGrid" Columns="8"/>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="특수문자">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <UniformGrid x:Name="SymGrid" Columns="8"/>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="이미지">
                                        <StackPanel Margin="4">
                                            <TextBox x:Name="ImgPathBox"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button x:Name="ImgBrowseBtn" Content="찾아보기" Width="80"/>
                                                <Button x:Name="ImgAttachBtn" Content="첨부" Width="60" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="첨부하면 셀 버튼에 이미지와 표시명이 함께 보입니다." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="SaveBtn" Content="적용·저장" Width="100"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="레이아웃">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="레이아웃 미리보기 + 위치/영역 편집" FontWeight="Bold"/>
                <TextBlock Text="프리셋 파일 (ini)"/>
                <ComboBox x:Name="PresetSelBox" Margin="0,2,0,2"/>
                <TextBlock x:Name="PresetPathLbl" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="레이아웃 (ini 섹션)"/>
                <ComboBox x:Name="LayoutSelBox" Margin="0,2,0,6"/>
                <Border BorderBrush="#335C6C7D" BorderThickness="1" CornerRadius="6" Background="#0A0F14" Margin="0,0,0,4" Padding="4">
                    <Canvas x:Name="LayoutPreview" Height="250" HorizontalAlignment="Stretch" Background="#0A0F14" ClipToBounds="True"/>
                </Border>
                <TextBlock x:Name="LayoutHoverLbl" Foreground="#35C4FF" FontSize="11" Margin="0,0,0,4" Text="X - Y -"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="PinModeBtn" Content="영역 찍기" Width="100"/>
                    <Button x:Name="PinClearBtn" Content="핀 지우기" Width="100" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LayoutInfoLbl" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="ZoneRectsLbl" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#E8ECF4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <CheckBox x:Name="PadZoneDef" Content="pad 기본값 사용" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="pad [" VerticalAlignment="Center"/>
                    <TextBox x:Name="ZoneXBox" Width="56" Margin="4,0,4,0"/>
                    <TextBox x:Name="ZoneYBox" Width="56" Margin="0,0,4,0"/>
                    <TextBlock Text="~" VerticalAlignment="Center"/>
                    <TextBox x:Name="ZoneX2Box" Width="56" Margin="4,0,4,0"/>
                    <TextBox x:Name="ZoneY2Box" Width="56" Margin="0,0,0,0"/>
                    <TextBlock Text="]" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="영역 모드"/>
                <ComboBox x:Name="LayoutAreaBox" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="X" VerticalAlignment="Center"/>
                    <TextBox x:Name="LayoutXBox" Width="64" Margin="4,0,8,0"/>
                    <TextBlock Text="Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="LayoutYBox" Width="64" Margin="4,0,8,0"/>
                    <TextBlock Text="W" VerticalAlignment="Center"/>
                    <TextBox x:Name="LayoutWBox" Width="64" Margin="4,0,8,0"/>
                    <TextBlock Text="H" VerticalAlignment="Center"/>
                    <TextBox x:Name="LayoutHBox" Width="64" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="X/Y/W/H는 custom 모드에서만 사용 (모니터 원점 기준 DIP)" Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="LayoutSaveBtn" Content="적용·저장" Width="100"/>
                    <Button x:Name="LayoutShowBtn" Content="패드 표시" Width="100" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="FloatPad">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="FloatPad 계열 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="floatpad / leftpad / rightpad / fullscreen …" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개 이상에서만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="RecBtn" Content="+ 제스처 추가" Width="100"/>
                    <TextBlock x:Name="RecStateLbl" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>
                <StackPanel x:Name="FloatGestureList" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="SaveBtnFloat" Content="적용·저장" Width="100"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="ArtistPad">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="ArtistPad 계열 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="이름에 Artist가 들어간 섹션" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개로만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="ArtistGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Separator Margin="0,8,0,8"/>
                <TextBlock Text="아티스트 패드 (버튼 바)" FontWeight="Bold"/>
                <TextBlock Text="위치"/>
                <ComboBox x:Name="ArtPos" Margin="0,2,0,4"/>
                <TextBlock Text="커스텀 버튼 (표시명 = 동작키)"/>
                <ListBox x:Name="ArtBtns" Height="110" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ArtLabel" Width="110"/>
                    <TextBox x:Name="ArtAction" Width="110" Margin="4,0,0,0"/>
                    <Button x:Name="ArtAdd" Content="추가" Width="60" Margin="4,0,0,0"/>
                    <Button x:Name="ArtDel" Content="삭제" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="SaveBtnArtist" Content="적용·저장" Width="100"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="VirtualCtrls">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="VirtualCtrls 레이아웃 제스처" FontWeight="Bold"/>
                <TextBlock Text="virtualctrls 섹션 (보조 컨트롤러)" Foreground="Gray"/>
                <TextBlock Text="제스처 동작은 손가락 2개로만 실행됩니다. 한 손가락은 커서만 (이동·탭·홀드). 두 손가락 = 세로 스크롤, 가로 스와이프 내비게이션." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="VirtualGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Separator Margin="0,8,0,8"/>
                <TextBlock Text="버추얼 패드 (버튼 바)" FontWeight="Bold"/>
                <TextBlock Text="레이아웃"/>
                <ComboBox x:Name="VirtPos" Margin="0,2,0,4"/>
                <TextBlock Text="커스텀 버튼 (표시명 = 동작키)"/>
                <ListBox x:Name="VirtBtns" Height="110" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="VirtLabel" Width="110"/>
                    <TextBox x:Name="VirtAction" Width="110" Margin="4,0,0,0"/>
                    <Button x:Name="VirtAdd" Content="추가" Width="60" Margin="4,0,0,0"/>
                    <Button x:Name="VirtDel" Content="삭제" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="SaveBtnVirtual" Content="적용·저장" Width="100"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="패드별">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <TextBlock Text="패드별 덮어쓰기 (전역과 동일 항목)" FontWeight="Bold"/>
                <TextBlock Text="패드"/>
                <ComboBox x:Name="PadSel" Margin="0,2,0,6"/>
                <TextBlock Text="영역 모드"/>
                <ComboBox x:Name="PadArea" Margin="0,2,0,6"/>
                <CheckBox x:Name="PadVisible" Content="영역 보이기 (fullscreen은 항상)" Margin="0,0,0,6"/>
                <TextBlock Text="투명도 (-1 = 전역 따름)"/>
                <TextBox x:Name="PadOpacity" Margin="0,2,0,6"/>
                <TextBlock Text="커서 속도 (-1 = 전역 따름)"/>
                <TextBox x:Name="PadSpeed" Margin="0,2,0,6"/>
                <TextBlock Text="판정 시간 ms (-1 = 전역 따름)"/>
                <TextBox x:Name="PadJudge" Margin="0,2,0,6"/>
                <TextBlock Text="스크롤 상하반전"/>
                <ComboBox x:Name="PadScroll" Margin="0,2,0,2"/>
                <TextBlock Text="좌/우 버튼 반전"/>
                <ComboBox x:Name="PadSwap" Margin="0,2,0,2"/>
                <TextBlock Text="Pad tap = click"/>
                <ComboBox x:Name="PadTap" Margin="0,2,0,6"/>
                <CheckBox x:Name="PadGesturesOwn" Content="이 패드만 제스처 따로 쓰기" Margin="0,2,0,2"/>
                <Grid x:Name="PadGestureGrid" Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Button x:Name="PadPreview" Content="미리보기 (해당 패드 적용)" Width="170" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="액션">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
