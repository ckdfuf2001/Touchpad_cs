<Window x:Class="TouchPadCloneV2.PadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchPad Clone" WindowStyle="None" AllowsTransparency="True"
        Background="#8C1B1E24" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Width="340" Height="290">
    <Border x:Name="Surface" Background="#8C1B1E24">
        <Grid>
            <!-- Tiles: full window (title bar is an overlay, not tile space) -->
            <Canvas x:Name="Tiles" />
            <!-- Corner resizer grips (visual only; input via zone math) -->
            <Canvas x:Name="Adorn" IsHitTestVisible="False" />
            <!-- Title bar overlay: NOT touchpad area, just attached on top -->
            <Border x:Name="TitleBar" VerticalAlignment="Top" Height="30"
                    Background="#CC141922">
                <Grid>
                    <TextBlock x:Name="ChromeLabel" Text="floatpad · 1.6x"
                               Foreground="#E8ECF4" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ChromeMenu" Content="⚙︎" Width="40" Height="24"
                                Margin="0,0,4,0" FontSize="14" FontFamily="Segoe UI Symbol"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusLabel" Text="ready" Foreground="#7FE0A8"
                       FontSize="10" Margin="8,0,0,8"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
