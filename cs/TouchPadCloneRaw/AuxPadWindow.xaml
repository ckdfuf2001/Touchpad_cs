<Window x:Class="TouchPadCloneV2.AuxPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AuxPad" WindowStyle="None" AllowsTransparency="True"
        Background="#B0141922" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" ResizeMode="NoResize" Width="340" Height="140">
    <StackPanel>
        <TextBlock x:Name="Title" Text="pad" Foreground="#E0C87F"
                   FontSize="12" Margin="8,4,0,2"/>
        <WrapPanel x:Name="Keys" Orientation="Horizontal" Margin="4"/>
    </StackPanel>
</Window>
